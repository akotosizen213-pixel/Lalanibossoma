    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local toggleBG = Instance.new("Frame", container)
    toggleBG.Size = UDim2.new(0, 44, 0, 24)
    toggleBG.Position = UDim2.new(1, -58, 0.5, -12)
    toggleBG.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    toggleBG.BorderSizePixel = 0
    local tbCorner = Instance.new("UICorner", toggleBG)
    tbCorner.CornerRadius = UDim.new(1, 0)

    local toggleKnob = Instance.new("Frame", toggleBG)
    toggleKnob.Size = UDim2.new(0, 18, 0, 18)
    toggleKnob.Position = UDim2.new(0, 3, 0.5, -9)
    toggleKnob.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
    toggleKnob.BorderSizePixel = 0
    local tkCorner = Instance.new("UICorner", toggleKnob)
    tkCorner.CornerRadius = UDim.new(1, 0)

    local state = false
    local function UpdateVisual()
        local goal = state and UDim2.new(0, 23, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        local colorBG = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 40)
        local colorKnob = state and Color3.fromRGB(10, 10, 10) or Color3.fromRGB(120, 120, 120)
        TweenService:Create(toggleKnob, TweenInfo.new(0.15), {Position = goal, BackgroundColor3 = colorKnob}):Play()
        TweenService:Create(toggleBG, TweenInfo.new(0.15), {BackgroundColor3 = colorBG}):Play()
    end

    local btn = Instance.new("TextButton", container)
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 3
    btn.MouseButton1Click:Connect(function()
        state = not state
        UpdateVisual()
        if callback then callback(state) end
    end)

    return container
end

