        if v then v:Destroy() end
    end
    ESPObjects = {}
end

local function CreateESP(player)
    if player == LocalPlayer then return end
    local billboard = Instance.new("BillboardGui")
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 120, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Adornee = nil

    local nameLabel = Instance.new("TextLabel", billboard)
    nameLabel.Size = UDim2.fromScale(1, 0.5)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextScaled = true

    local healthLabel = Instance.new("TextLabel", billboard)
    healthLabel.Size = UDim2.fromScale(1, 0.5)
    healthLabel.Position = UDim2.fromScale(0, 0.5)
    healthLabel.BackgroundTransparency = 1
    healthLabel.TextColor3 = Color3.fromRGB(180, 255, 180)
    healthLabel.TextStrokeTransparency = 0
    healthLabel.Font = Enum.Font.Gotham
    healthLabel.TextScaled = true

    ESPObjects[player.Name] = billboard

    Connections["ESP_" .. player.Name] = RunService.RenderStepped:Connect(function()
        if not State.ESP then
            billboard.Enabled = false
            return
        end
        local char = player.Character
        if not char then billboard.Enabled = false return end
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not head or not hum then billboard.Enabled = false return end
        billboard.Adornee = head
        billboard.Enabled = true
        healthLabel.Text = "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
    end)
end

local function StartESP()
    ClearESP()
    for _, p in ipairs(Players:GetPlayers()) do
        CreateESP(p)
    end
    Players.PlayerAdded:Connect(function(p)
        task.wait(1)
        if State.ESP then CreateESP(p) end
    end)
end

